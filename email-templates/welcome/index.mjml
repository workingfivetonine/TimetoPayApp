<mjml>
  <mj-head>
    <mj-preview>Your grocery prices, tracked automatically.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#3F3F46" font-size="16px" line-height="1.6" />
    </mj-attributes>
    <mj-style>a { color: #7C3AED; }</mj-style>
  </mj-head>

  <mj-body background-color="#F4F4F7">
    <!-- Brand accent bar -->
    <mj-section background-color="#7C3AED" padding="0">
      <mj-column><mj-spacer height="6px" /></mj-column>
    </mj-section>

    <!-- Logo + content card -->
    <mj-section background-color="#FFFFFF" padding="28px 24px 8px">
      <mj-column>
        <mj-image src="https://5to9shopping.com/icon-512.png" alt="TimetoPay" width="44px" padding="0 0 12px" border-radius="10px" />
        <mj-text font-size="23px" font-weight="700" color="#18181B" line-height="1.3">Welcome to TimetoPay, {firstName} 🛒</mj-text>
        <mj-text>You're all set to start spending less on groceries. The fastest way to see it work:</mj-text>
        <mj-text line-height="1.7">
          📸 <strong>Scan a receipt</strong> — we pull out every item &amp; price.<br />
          📈 <strong>Build your price history</strong> — the best store &amp; price for what you buy.<br />
          🛒 <strong>Get a smart shopping list</strong> — built from your purchases.
        </mj-text>
        <mj-button background-color="#7C3AED" href="https://5to9shopping.com/scan" border-radius="10px" font-size="16px" font-weight="600" inner-padding="14px 28px" padding="22px 0 8px" align="center">
          Scan your first receipt →
        </mj-button>
        <mj-divider border-color="#ECECEF" border-width="1px" padding="16px 0 0" />
        <mj-text font-size="12px" color="#B4B4BB" padding="12px 0 28px">
          Happy saving, the TimetoPay team<br />
          FivetoNine LLC · 483 Chestnut Street, Cedarhurst, NY 11518<br />
          <a href="https://5to9shopping.com">5to9shopping.com</a> · <a href="{unsubscribe_link}">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

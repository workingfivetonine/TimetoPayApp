<mjml>
  <mj-head>
    <mj-title>Your grocery month</mj-title>
    <mj-preview>{EVENT_PROPERTY:periodStart} – {EVENT_PROPERTY:periodEnd}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="#3A4B52" font-size="16px" line-height="1.6" />
    </mj-attributes>
    <mj-style inline="inline">
      a { color: #04576A; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F7F6F9" width="600px">
    <!-- brand accent bar -->
    <mj-section background-color="#04576A" padding="0" border-radius="16px 16px 0 0">
      <mj-column><mj-spacer height="6px" /></mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="28px 32px 8px">
      <mj-column>
        <mj-image src="https://5to9shopping.com/icon-512.png" alt="TimetoPay" width="44px" align="left" padding="0 0 16px" border-radius="10px" />
        <mj-text font-size="23px" font-weight="700" color="#17242B" line-height="1.3" padding="0 0 14px">Your grocery month</mj-text>
        <mj-text font-size="13px" color="#4C6B66" padding="0 0 14px">{EVENT_PROPERTY:periodStart} – {EVENT_PROPERTY:periodEnd}</mj-text>
        <mj-text padding="0 0 12px">Hi {firstName}, here's how the month went:</mj-text>
        <mj-text line-height="1.9" padding="0 0 4px">🧾 <strong>Spent this month:</strong> ${EVENT_PROPERTY:total}<br />📅 <strong>Month before:</strong> ${EVENT_PROPERTY:previousTotal}<br />📈 <strong>Change:</strong> {EVENT_PROPERTY:changeDirection} ${EVENT_PROPERTY:changeAmount}</mj-text>
        <mj-button background-color="#04576A" color="#FFFFFF" href="https://5to9shopping.com" border-radius="10px" font-size="16px" font-weight="600" inner-padding="14px 28px" padding="22px 0 6px" align="left">See your analytics →</mj-button>
        <mj-divider border-color="#E6E4EC" border-width="1px" padding="20px 0 0" />
        <mj-text font-size="12px" color="#8FA3A0" line-height="1.6" padding="14px 0 28px">
          The TimetoPay team<br />
          FivetoNine LLC · 483 Chestnut Street, Cedarhurst, NY 11518<br />
          <a href="https://5to9shopping.com" style="color:#8FA3A0;">5to9shopping.com</a> · <a href="{unsubscribe_link}" style="color:#8FA3A0;">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
